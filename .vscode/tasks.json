{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                "${workspaceFolder}/tool/build.ps1",
                "-Configuration",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                "${workspaceFolder}/tool/build.ps1",
                "-Configuration",
                "Release"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Clean Debug",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                "${workspaceFolder}/tool/build.ps1",
                "-Configuration",
                "Debug",
                "-Clean"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Clean Release",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File",
                "${workspaceFolder}/tool/build.ps1",
                "-Configuration",
                "Release",
                "-Clean"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Rebuild Release",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Clean Release",
                "Build Release"
            ],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Run Release Binary",
            "type": "process",
            "command": "${workspaceFolder}\\x64\\Release\\expogame.exe",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "_NO_DEBUG_HEAP": "1"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Run Release (No Debugger)",
            "type": "process",
            "command": "${workspaceFolder}\\x64\\Release\\expogame.exe",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "_NO_DEBUG_HEAP": "1"
                }
            },
            "dependsOn": "Build Release",
            "problemMatcher": []
        },
        {
            "label": "Rebuild and Run Release (No Debugger)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Clean Release",
                "Build Release",
                "Run Release Binary"
            ],
            "problemMatcher": []
        }
    ]
}
